HTTP_PORT=8080

POSTGRES_DSN=postgres://gav:gav@localhost:5433/gav_social?sslmode=disable

JWT_SECRET=super-secret-key
JWT_TTL=24h

STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# Docker Compose enables Kafka; for direct local runs enable it only after starting a broker.
KAFKA_ENABLED=false
KAFKA_BROKERS=localhost:9092
KAFKA_CONSUMER_GROUP=gav-social-network

# Firebase push requires a real service-account JSON and APNs/FCM setup on iOS.
FIREBASE_ENABLED=false
# FIREBASE_CREDENTIALS_FILE=/absolute/path/to/firebase-service-account.json

# Messenger service
GRPC_ADDR=:9090
HTTP_ADDR=:8082
REDIS_ADDR=localhost:6379
# Messenger uses a separate database; when starting it outside Compose, override
# POSTGRES_DSN with postgres://gav:gav@localhost:5433/gav?sslmode=disable.
SOCIAL_NETWORK_ADDR=localhost:9000
